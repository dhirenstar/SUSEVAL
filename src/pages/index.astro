---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import TeamCard from '../components/TeamCard.astro';
import FAQItem from '../components/FAQItem.astro';

const pdfBase = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/documents/`;
---

<BaseLayout
  title="SUSEVAL | Evaluating the System Usability Scale for South African languages"
  description="Completed University of Cape Town research on language and administration mode in the System Usability Scale."
>
  <Header />

  <main id="main-content">
    <section class="hero" aria-labelledby="hero-heading">
      <div class="hero__pattern" aria-hidden="true"></div>
      <div class="container hero__inner">
        <p class="hero__eyebrow">University of Cape Town · Completed Honours Research Project</p>
        <h1 id="hero-heading">Evaluating the System Usability Scale for South African languages</h1>
        <p class="hero__intro">
          SUSEVAL examined what happens to the System Usability Scale (SUS) when it is translated
          into isiXhosa and Afrikaans, or read aloud instead of read on screen.
        </p>
        <div class="hero__actions">
          <Button href="#findings">View the findings</Button>
          <Button href="#papers" variant="secondary">Read the papers</Button>
        </div>
      </div>
    </section>

    <Section
      id="about"
      label="Project overview"
      title="Usability research in a multilingual setting"
      description="Three students ran complementary arms of a shared study at the University of Cape Town."
    >
      <div class="content-grid content-grid--2">
        <div class="card">
          <h3>Background and motivation</h3>
          <p>
            The SUS is a ten-item questionnaire that turns agreement with statements about a
            system into a perceived-usability score from 0 to 100. It was written in English,
            while South Africa has twelve official languages and English is the home language of
            a minority of people in the Western Cape.
          </p>
          <p>
            SUSEVAL addressed the limited published work on the SUS in South African languages
            and on how wording and administration shape responses. The project did not validate
            an instrument or test measurement equivalence.
          </p>
        </div>
        <div class="card">
          <h3>Shared study design</h3>
          <ul class="info-list">
            <li>Adults were recruited through university channels, community networks, and snowball sampling.</li>
            <li>Participants rated everyday systems including ATMs, EskomSePush, Google Search, point-of-sale machines, Takealot, and Uber.</li>
            <li>Each arm used a within-subjects design and added reflexive thematic analysis of participant feedback.</li>
          </ul>
          <p class="note"><strong>Important:</strong> Samples were small and purposive. Written English always came first, and different systems were used in the two conditions.</p>
        </div>
      </div>
    </Section>

    <Section id="sus" label="The System Usability Scale" title="A short measure with a wide reach" alt={true}>
      <div class="content-grid content-grid--2">
        <div>
          <h3>What is the SUS?</h3>
          <p>
            Developed by John Brooke in 1986, the SUS is a standardised ten-item questionnaire
            about a system someone has used. It is short, widely used, and produces a score
            between 0 and 100. A SUS score is not a percentage; it is a consistent way to
            compare perceived usability across systems and studies.
          </p>
        </div>
        <div>
          <h3>What SUSEVAL asked</h3>
          <ul class="info-list">
            <li>How do SUS scores and participant experiences differ between written English and written isiXhosa?</li>
            <li>How does oral administration compare with written administration of the English SUS?</li>
            <li>How can the SUS be adapted into Afrikaans while preserving meaning across cultures?</li>
          </ul>
        </div>
      </div>
    </Section>

    <Section id="languages" label="Study arms" title="Three complementary investigations">
      <div class="content-grid content-grid--3">
        <article class="card arm-card">
          <p class="arm-card__label">28 participants</p>
          <h3>isiXhosa SUS</h3>
          <p>Developed an isiXhosa SUS and compared it with written English among isiXhosa first-language speakers.</p>
          <a href="#paper-isixhosa">Read the summary</a>
        </article>
        <article class="card arm-card">
          <p class="arm-card__label">25 participants</p>
          <h3>Oral administration</h3>
          <p>Compared oral and written administration of the English SUS, including how participants experienced an interviewer.</p>
          <a href="#paper-oral">Read the summary</a>
        </article>
        <article class="card arm-card">
          <p class="arm-card__label">7 participants</p>
          <h3>Afrikaans SUS</h3>
          <p>Created AF-SUS through a documented cross-cultural adaptation process and explored how bilingual participants experienced it.</p>
          <a href="#paper-afrikaans">Read the summary</a>
        </article>
      </div>
    </Section>

    <Section id="findings" label="Key findings" title="Similar averages, different experiences" alt={true}>
      <p class="section__description">Mean SUS scores were close in all three arms, and no difference was statistically detectable. Bars show mean scores out of 100.</p>
      <div class="findings">
        <div class="finding">
          <h3>isiXhosa arm</h3>
          <div class="bar"><span>English</span><i style="width: 74.85%"></i><b>74.85</b></div>
          <div class="bar bar--alt"><span>isiXhosa</span><i style="width: 75.48%"></i><b>75.48</b></div>
        </div>
        <div class="finding">
          <h3>Oral administration arm</h3>
          <div class="bar"><span>Written</span><i style="width: 79%"></i><b>79.0</b></div>
          <div class="bar bar--alt"><span>Oral</span><i style="width: 77%"></i><b>77.0</b></div>
        </div>
        <div class="finding">
          <h3>Afrikaans arm</h3>
          <div class="bar"><span>English</span><i style="width: 73.57%"></i><b>73.57</b></div>
          <div class="bar bar--alt"><span>Afrikaans</span><i style="width: 76.25%"></i><b>76.25</b></div>
        </div>
      </div>
      <div class="content-grid content-grid--2 findings-summary">
        <div class="card">
          <h3>What participants told us</h3>
          <ul>
            <li>English was often easier because of familiarity with written English and technology terms.</li>
            <li>Oral administration allowed clarification, but could create pressure or a sense of judgement.</li>
            <li>Understanding, naturalness, ease, and language preference did not always align.</li>
          </ul>
        </div>
        <div class="card">
          <h3>How to interpret the results</h3>
          <p>
            Similar means do not show that the versions are equivalent. Language, order, and
            system could not be separated in the designs, and the findings apply mainly to
            fluent English speakers.
          </p>
        </div>
      </div>
    </Section>

    <Section id="papers" label="Research papers" title="Read the three project papers">
      <article class="paper card" id="paper-isixhosa">
        <div><p class="paper__author">Inhle Cele</p><h3>When the Questionnaire Speaks isiXhosa but the System Speaks English</h3></div>
        <p>Developed an isiXhosa SUS and compared it with English among 28 isiXhosa home-language speakers. The primary model estimated an isiXhosa-minus-English difference of 0.97 SUS points (95% CI −4.38 to 6.32; p = .713).</p>
        <Button href={`${pdfBase}Cele_isiXhosa_SUS_paper.pdf`} variant="secondary">Download full paper (PDF)</Button>
      </article>
      <article class="paper card" id="paper-oral">
        <div><p class="paper__author">Dhiren Chetty</p><h3>The Effect of Administration Modality on Usability Perceptions Measured Using the System Usability Scale</h3></div>
        <p>Compared oral and written English SUS administration among 25 participants. Scores were broadly comparable while engagement differed: oral minus written was −1.93 points (95% CI −6.61 to 2.75; p = .402).</p>
        <Button href={`${pdfBase}Chetty_Oral_SUS_paper.pdf`} variant="secondary">Download full paper (PDF)</Button>
      </article>
      <article class="paper card" id="paper-afrikaans">
        <div><p class="paper__author">Yazeed Adams</p><h3>Cross-cultural adaptation of the System Usability Scale into Afrikaans</h3></div>
        <p>Presented AF-SUS and examined it with Afrikaans-speaking participants who completed both versions. English averaged 73.57 and Afrikaans 76.25 in the descriptive comparison.</p>
        <Button href={`${pdfBase}Adams_Afrikaans_SUS_paper.pdf`} variant="secondary">Download full paper (PDF)</Button>
      </article>
    </Section>

    <Section id="procedure" label="Methods and limitations" title="A documented research process" alt={true}>
      <div class="content-grid content-grid--2">
        <div class="card">
          <h3>Adaptation work</h3>
          <p>
            The isiXhosa arm used two forward translations, synthesis by a language specialist,
            two independent back-translations, discrepancy review, and pretesting. The
            Afrikaans arm used researcher and machine forward translations, expert synthesis,
            pretesting with six participants, and final revision. Translation focused on
            semantic, idiomatic, experiential, and conceptual meaning rather than word-for-word
            substitution.
          </p>
        </div>
        <div class="card">
          <h3>Limitations</h3>
          <ul>
            <li>Small, purposive samples and mostly fluent English speakers.</li>
            <li>Written English always preceded the second condition.</li>
            <li>Different systems were rated across conditions in the language arms.</li>
            <li>The studies do not establish measurement invariance or full validity.</li>
          </ul>
        </div>
      </div>
    </Section>

    <Section id="team" label="Research team" title="The people behind SUSEVAL">
      <div class="content-grid content-grid--3">
        <TeamCard name="Inhle Cele" role="Honours Researcher"><p>University of Cape Town</p></TeamCard>
        <TeamCard name="Dhiren Chetty" role="Honours Researcher"><p>University of Cape Town</p></TeamCard>
        <TeamCard name="Yazeed Adams" role="Honours Researcher"><p>University of Cape Town</p></TeamCard>
      </div>
      <p class="team-note">Supervisor named in the papers' acknowledgements: Melissa Densmore.</p>
    </Section>

    <Section id="faq" label="Frequently asked questions" title="About the completed study" alt={true}>
      <FAQItem question="Was the study a validation of the translated SUS versions?">
        <p>No. The papers document adaptation processes and report preliminary evidence. They do not establish measurement invariance or full validity.</p>
      </FAQItem>
      <FAQItem question="Why were the scores similar if participants had different experiences?">
        <p>Averages can be close while wording familiarity, register, clarification, and social pressure affect how people experience a questionnaire. Similar averages do not prove that versions are interchangeable.</p>
      </FAQItem>
      <FAQItem question="What ethics approval did the project receive?">
        <p>The project received approval from the Faculty of Science Research Ethics Committee at the University of Cape Town (SCI/02801/2026).</p>
      </FAQItem>
      <FAQItem question="Can I still participate?">
        <p>The SUSEVAL study has been completed and is no longer collecting participants. The papers and findings on this site are provided as the project's public record.</p>
      </FAQItem>
    </Section>

    <Section id="contact" label="Contact and resources" title="Project information">
      <div class="content-grid content-grid--2">
        <div class="card">
          <h3>Institution</h3>
          <p>SUSEVAL was an Honours project in the Department of Computer Science at the <a href="https://www.uct.ac.za/" target="_blank" rel="noopener noreferrer">University of Cape Town</a>.</p>
          <p>Ethics approval: Faculty of Science Research Ethics Committee, SCI/02801/2026.</p>
        </div>
        <div class="card">
          <h3>Project documents</h3>
          <ul>
            <li><a href={`${pdfBase}Cele_isiXhosa_SUS_paper.pdf`}>Cele: isiXhosa SUS paper</a></li>
            <li><a href={`${pdfBase}Chetty_Oral_SUS_paper.pdf`}>Chetty: oral administration paper</a></li>
            <li><a href={`${pdfBase}Adams_Afrikaans_SUS_paper.pdf`}>Adams: Afrikaans SUS paper</a></li>
          </ul>
        </div>
      </div>
    </Section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .hero { position: relative; padding-block: var(--space-4xl) var(--space-3xl); background: linear-gradient(160deg, var(--color-navy-dark), var(--color-navy) 55%, var(--color-navy-light)); color: #fff; overflow: hidden; }
  .hero__pattern { position: absolute; inset: 0; background-image: radial-gradient(circle at 20% 80%, rgba(184,149,74,.12), transparent 50%), radial-gradient(circle at 80% 20%, rgba(255,255,255,.05), transparent 40%); }
  .hero__inner { position: relative; max-width: 52rem; }
  .hero__eyebrow { margin: 0 0 var(--space-md); color: var(--color-gold-light); font-size: var(--text-sm); font-weight: 600; letter-spacing: .04em; text-transform: uppercase; }
  .hero h1 { margin: 0 0 var(--space-lg); color: #fff; font-size: clamp(2.35rem, 6vw, 3.5rem); }
  .hero__intro { max-width: 44rem; margin: 0 0 var(--space-xl); color: rgba(255,255,255,.82); font-size: var(--text-lg); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-md); }
  .hero__actions :global(.btn--primary) { background: var(--color-gold); color: var(--color-navy-dark); }
  .hero__actions :global(.btn--secondary) { border-color: rgba(255,255,255,.5); color: #fff; }
  .arm-card { display: flex; flex-direction: column; }
  .arm-card h3 { margin-bottom: var(--space-sm); }
  .arm-card a { margin-top: auto; font-weight: 600; }
  .arm-card__label, .paper__author { margin: 0 0 var(--space-xs); color: var(--color-gold); font-size: var(--text-sm); font-weight: 700; }
  .findings { display: grid; gap: var(--space-xl); margin-top: var(--space-xl); }
  .finding { padding: var(--space-lg); background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); }
  .finding h3 { margin-top: 0; font-size: var(--text-lg); }
  .bar { display: grid; grid-template-columns: 6rem 1fr 3.5rem; align-items: center; gap: var(--space-sm); margin-top: var(--space-sm); font-size: var(--text-sm); }
  .bar i { display: block; height: .75rem; background: var(--color-navy-light); border-radius: 999px; }
  .bar--alt i { background: var(--color-gold); }
  .bar b { text-align: right; font-variant-numeric: tabular-nums; }
  .findings-summary { margin-top: var(--space-xl); }
  .note { padding: var(--space-md); background: rgba(184,149,74,.1); border-left: 3px solid var(--color-gold); color: var(--color-text-muted); font-size: var(--text-sm); }
  .paper { display: grid; gap: var(--space-md); margin-top: var(--space-lg); }
  .paper h3 { margin: 0; }
  .paper p { color: var(--color-text-muted); }
  .paper .btn { justify-self: start; }
  .team-note { margin-top: var(--space-xl); color: var(--color-text-muted); }
  @media (min-width: 48rem) { .findings { grid-template-columns: repeat(3, 1fr); } .paper { grid-template-columns: 1.2fr 1.8fr auto; align-items: center; } }
</style>
